# ============================================================================
# Apigee X Full-Fledged Terraform Configuration (terraform.tfvars)
# Copy to terraform.tfvars and set project_id + region.
# Evaluation organizations are not supported (paid PAYG or SUBSCRIPTION only).
# ============================================================================

project_id = "replace-with-your-gcp-project-id"
region     = "asia-south1"

# 1. Billing Model: "PAYG" (default) or "SUBSCRIPTION"
billing_type = "PAYG"

# 2. Environments: defaults to INTERMEDIATE with Analytics enabled
environments = {
  dev = {
    type      = "INTERMEDIATE" # BASE | INTERMEDIATE | COMPREHENSIVE (PAYG only)
    analytics = true           # Enable PAYG Analytics add-on
    envgroup  = "dev-group"
  }
  # prod = {
  #   type      = "COMPREHENSIVE"
  #   analytics = true
  #   envgroup  = "prod-group"
  # }
}

# 3. Networking Topology: "PSC" (default, no VPC peering) or "VPC_PEERING"
network_mode = "PSC"
# network    = "projects/my-proj/global/networks/my-vpc"
# subnetwork = "projects/my-proj/regions/asia-south1/subnetworks/my-subnet"

# 4. Encryption: Google-managed keys by default (use_cmek = false). Set true for Cloud KMS CMEK.
use_cmek = false

# 5. Data Residency: disabled by default (null). Set both below to enable regional data residency:
# control_plane_location = "us"
# consumer_data_region   = "us-west1"

# 6. Northbound Routing, Domain & TLS Certificate:
#    routing   = "external" (default Global HTTPS LB) | "external-regional" | "internal" | "none"
#    cert_mode = "google_managed" (default) | "existing" | "self_managed"
routing   = "external"
cert_mode = "google_managed"

# Domain defaults to <envgroup>.<lb-ip-with-dashes>.nip.io when omitted.
# Uncomment for custom domain(s) (and optionally dns_managed_zone to auto-create Cloud DNS A records):
# envgroup_hostnames = {
#   "dev-group" = ["api.dev.example.com"]
# }
# dns_managed_zone = "example-com-zone"

# 7. Optional Enterprise Features (Multi-region HA, WAF, Static NAT, Southbound PSC, Add-ons):
# additional_regions = {
#   "asia-south2" = {}
# }
# enable_cloud_armor   = true
# enable_http_redirect = true
# enable_nat_ips       = true
# addons = {
#   api_security = true
# }
# southbound_psc_endpoints = {
#   "orders-psc" = {
#     location           = "asia-south1"
#     service_attachment = "projects/backend-proj/regions/asia-south1/serviceAttachments/orders-sa"
#   }
# }
